%{
/* =============================================================
 * lexer.l  –  Lexer for a Minimal Modula-2 Subset
 * (Phase 2 of the assignment: Parsing and Intermediate Code Generation)
 *
 * Same token set as phase1-lexical-analysis/lexer.l, adapted to feed
 * Bison instead of printing tokens directly:
 *   - Returns generated token constants (parser.tab.h) instead of
 *     printing a description
 *   - IDENTIFIER / NUMBER rules also save their matched text into
 *     yylval.sval, since the parser's TAC generation needs the
 *     actual name/value, not just the token type
 * =============================================================
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "parser.tab.h"   /* generated by: bison -d parser.y */
%}

/* ── Exclusive start state for Modula-2 block comments (* … *) ── */
%x COMMENT

%%

    /* ── Block comments: (* … *) ──────────────────────────── */
"(*"                    { BEGIN(COMMENT); }
<COMMENT>"*)"           { BEGIN(INITIAL); }
<COMMENT>.|\n           { /* Ignore everything inside comments */ }


    /* ── Keywords ─────────────────────────────────────────── */
"MODULE"                { return MODULE;   }
"BEGIN"                 { return KW_BEGIN; }
"END"                   { return END;      }
"VAR"                   { return VAR;      }
"INTEGER"               { return INTEGER;  }
"BOOLEAN"               { return BOOLEAN;  }
"IF"                    { return IF;       }
"THEN"                  { return THEN;     }
"ELSE"                  { return ELSE;     }
"WHILE"                 { return WHILE;    }
"DO"                    { return DO;       }
"AND"                   { return AND;      }
"OR"                    { return OR;       }
"NOT"                   { return NOT;      }
"TRUE"                  { return TRUE;     }
"FALSE"                 { return FALSE;    }


    /* ── Multi-character operators ─────────────────────────── */
":="                    { return ASSIGN; }
"<="                    { return LE;     }
">="                    { return GE;     }
"<>"                    { return NE;     }


    /* ── Single-character operators ────────────────────────── */
"+"                     { return '+'; }
"-"                     { return '-'; }
"*"                     { return '*'; }
"/"                     { return '/'; }
"="                     { return '='; }
"<"                     { return '<'; }
">"                     { return '>'; }


    /* ── Punctuation ────────────────────────────────────────── */
";"                     { return ';'; }
":"                     { return ':'; }
","                     { return ','; }
"("                     { return '('; }
")"                     { return ')'; }
"."                     { return '.'; }


    /* ── Identifiers: save text for TAC generation ─────────── */
[a-zA-Z][a-zA-Z0-9]*   {
                            yylval.sval = strdup(yytext);
                            return IDENTIFIER;
                        }

    /* ── Numeric literals: save text for TAC generation ──────── */
[0-9]+                  {
                            yylval.sval = strdup(yytext);
                            return NUMBER;
                        }


    /* ── Whitespace: skip silently ──────────────────────────── */
" "                     { /* skip space      */ }
"\t"                    { /* skip tab        */ }
"\n"                    { yylineno++;           }
"\r"                    { /* skip Windows CR */ }


    /* ── Catch-all: unknown character ──────────────────────── */
.                       { fprintf(stderr, "Lexical error – unknown character: '%s'\n", yytext); }

%%

/* ─────────────────────────────────────────────────────────────
 * yywrap() – signals end-of-input to Flex
 * ───────────────────────────────────────────────────────────── */
int yywrap(void)
{
    return 1;
}
